                                    <!-- 主控按钮 -->
                                    <UniformGrid Columns="4" Margin="0,0,0,8">
                                        <Button Content="启动拉载" Style="{StaticResource SuccessButtonStyle}" Height="32" Margin="4" Click="btn_LoadStart_Click"/>
                                        <Button Content="暂停拉载" Style="{StaticResource WarningButtonStyle}" Height="32" Margin="4" Click="btn_LoadPause_Click"/>
