                                    <Button Grid.Column="1" Name="btn_BMS_AllowDischarge"
                                            Content="允许放电"
                                            Style="{StaticResource SuccessButtonStyle}"
                                            Margin="4"
                                            Click="btn_BMS_AllowDischarge_Click"/>

                                    <Button Grid.Column="2" Name="btn_BMS_AllowBoth"
                                            Content="允许充放电"
                                            Style="{StaticResource SuccessButtonStyle}"
                                            Margin="4"
                                            Click="btn_BMS_AllowBoth_Click"/>

                                    <Button Grid.Column="3" Name="btn_BMS_Forbid"
                                            Content="禁止充放电"
                                            Style="{StaticResource StopButtonStyle}"
                                            Margin="4"
                                            Click="btn_BMS_Forbid_Click"/>
                                </Grid>
                            </GroupBox>

                            <!-- BMS故障信息 -->
                            <GroupBox Header="故障信息" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="当前故障=reg137告警/138保护/139故障位解码(附表1/2/3), 随上方自动刷新更新; 历史故障本期不支持" Foreground="#FFB26B" Margin="4,0,4,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Label Grid.Row="0" Grid.Column="0" Content="当前故障:" Style="{StaticResource LabelStyle}" Margin="4" VerticalAlignment="Top"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Name="tbx_BMS_CurrentFault" 
                                                 Style="{StaticResource StandardTextBoxStyle}" 
                                                 Text="--" 
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 Height="60"
                                                 VerticalContentAlignment="Top"
                                                 Margin="4"/>

                                        <Label Grid.Row="1" Grid.Column="0" Content="历史故障:" Style="{StaticResource LabelStyle}" Margin="4" VerticalAlignment="Top"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Name="tbx_BMS_HistoryFault" 
                                                 Style="{StaticResource StandardTextBoxStyle}" 
                                                 Text="--" 
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 Height="60"
                                                 VerticalContentAlignment="Top"
                                                 Margin="4"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </hc:TabItem>

                <!-- 通信日志 Tab -->
                <hc:TabItem Header="通信日志">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource RegionBrush}"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,0,0,10">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <CheckBox Content="暂停记录"
                                              IsChecked="{Binding IsCommunicationLogPaused, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,18,0"/>
                                    <CheckBox Name="chk_AutoScrollCommunicationLog"
                                              Content="自动滚动"
                                              IsChecked="True"
                                              VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,16,0">
                                        <Run Text="当前缓存："/>
                                        <Run Text="{Binding CommunicationLogs.Count, Mode=OneWay}"/>
                                        <Run Text=" 条"/>
                                    </TextBlock>
                                    <Button Content="清空"
                                            Style="{StaticResource WarningButtonStyle}"
                                            Command="{Binding ClearCommunicationLogCommand}"
                                            Width="80"
                                            Height="32"
                                            Margin="0,0,6,0"/>
                                    <Button Content="复制选中"
                                            Style="{StaticResource StandardButtonStyle}"
                                            Width="90"
                                            Height="32"
                                            Margin="0,0,6,0"
                                            Click="btn_CopyCommunicationLog_Click"/>
                                    <Button Content="保存日志"
                                            Style="{StaticResource SuccessButtonStyle}"
                                            Width="90"
                                            Height="32"
                                            Click="btn_SaveCommunicationLog_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ListBox Grid.Row="1"
                                 Name="lbx_CommunicationLog"
                                 ItemsSource="{Binding CommunicationLogs}"
                                 SelectionMode="Extended"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}"
                                               TextWrapping="NoWrap"
                                               Padding="4,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </hc:TabItem>

                <!-- 拉载配方 Tab -->
                <hc:TabItem Header="拉载参数" Visibility="Collapsed">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 工具栏 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <Button Name="btn_NewRecipe" Content="新建参数" Style="{StaticResource StandardButtonStyle}" Width="90" Height="32" Margin="0,0,6,0" Click="btn_NewRecipe_Click"/>
                            <Button Name="btn_CopyRecipe" Content="复制参数" Style="{StaticResource StandardButtonStyle}" Width="90" Height="32" Margin="0,0,6,0" Click="btn_CopyRecipe_Click"/>
                            <Button Name="btn_RenameRecipe" Content="重命名" Style="{StaticResource WarningButtonStyle}" Width="80" Height="32" Margin="0,0,6,0" Click="btn_RenameRecipe_Click"/>
                            <Button Name="btn_DeleteRecipe" Content="删除参数" Style="{StaticResource StopButtonStyle}" Width="90" Height="32" Margin="0,0,6,0" Click="btn_DeleteRecipe_Click"/>
                            <Button Name="btn_SaveRecipe" Content="保存参数" Style="{StaticResource SuccessButtonStyle}" Width="90" Height="32" Click="btn_SaveRecipe_Click"/>
                        </StackPanel>

                        <!-- 主体：左右两栏 -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左侧：配方列表 -->
                            <hc:Card Grid.Column="0" Margin="0,0,10,0" BorderThickness="0" Effect="{StaticResource EffectShadow2}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="配方列表"
                                               Style="{StaticResource TextBlockHeader}"
                                               Margin="0,0,0,10"/>
                                    <ListBox Name="lbx_RecipeList"
                                             SelectionChanged="lbx_RecipeList_SelectionChanged"
                                             DisplayMemberPath="Name"
                                             FontSize="12"/>
                                </DockPanel>
                            </hc:Card>

                            <!-- 右侧：参数编辑 + 操作按钮 -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Name="tbk_CurrentRecipeName" Text="请选择一个参数"
                                               Style="{StaticResource TextBlockHeader}"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,0,0,10"/>

                                    <GroupBox Header="时序参数" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Label Grid.Row="0" Grid.Column="0" Content="时序1电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Name="tbx_RecipeSeq1_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="0" Grid.Column="2" Content="时序1时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="0" Grid.Column="3" Name="tbx_RecipeSeq1_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="1" Grid.Column="0" Content="时序2电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Name="tbx_RecipeSeq2_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="1" Grid.Column="2" Content="时序2时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="1" Grid.Column="3" Name="tbx_RecipeSeq2_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="2" Grid.Column="0" Content="时序3电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Name="tbx_RecipeSeq3_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="2" Grid.Column="2" Content="时序3时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="2" Grid.Column="3" Name="tbx_RecipeSeq3_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="3" Grid.Column="0" Content="时序4电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Name="tbx_RecipeSeq4_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="3" Grid.Column="2" Content="时序4时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="3" Grid.Column="3" Name="tbx_RecipeSeq4_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="4" Grid.Column="0" Content="时序5电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Name="tbx_RecipeSeq5_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="4" Grid.Column="2" Content="时序5时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="4" Grid.Column="3" Name="tbx_RecipeSeq5_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="5" Grid.Column="0" Content="时序6电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="5" Grid.Column="1" Name="tbx_RecipeSeq6_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="5" Grid.Column="2" Content="时序6时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="5" Grid.Column="3" Name="tbx_RecipeSeq6_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="6" Grid.Column="0" Content="时序7电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="6" Grid.Column="1" Name="tbx_RecipeSeq7_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="6" Grid.Column="2" Content="时序7时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="6" Grid.Column="3" Name="tbx_RecipeSeq7_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="7" Grid.Column="0" Content="时序8电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="7" Grid.Column="1" Name="tbx_RecipeSeq8_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="7" Grid.Column="2" Content="时序8时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="7" Grid.Column="3" Name="tbx_RecipeSeq8_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="8" Grid.Column="0" Content="时序9电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="8" Grid.Column="1" Name="tbx_RecipeSeq9_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="8" Grid.Column="2" Content="时序9时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="8" Grid.Column="3" Name="tbx_RecipeSeq9_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="9" Grid.Column="0" Content="时序10电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="9" Grid.Column="1" Name="tbx_RecipeSeq10_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="9" Grid.Column="2" Content="时序10时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="9" Grid.Column="3" Name="tbx_RecipeSeq10_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="10" Grid.Column="0" Content="时序11电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="10" Grid.Column="1" Name="tbx_RecipeSeq11_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="10" Grid.Column="2" Content="时序11时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="10" Grid.Column="3" Name="tbx_RecipeSeq11_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="11" Grid.Column="0" Content="时序12电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="11" Grid.Column="1" Name="tbx_RecipeSeq12_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="11" Grid.Column="2" Content="时序12时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="11" Grid.Column="3" Name="tbx_RecipeSeq12_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="12" Grid.Column="0" Content="时序13电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="12" Grid.Column="1" Name="tbx_RecipeSeq13_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="12" Grid.Column="2" Content="时序13时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="12" Grid.Column="3" Name="tbx_RecipeSeq13_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="13" Grid.Column="0" Content="时序14电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="13" Grid.Column="1" Name="tbx_RecipeSeq14_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="13" Grid.Column="2" Content="时序14时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="13" Grid.Column="3" Name="tbx_RecipeSeq14_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>

                                            <Label Grid.Row="14" Grid.Column="0" Content="时序15电流 (0.1A):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="14" Grid.Column="1" Name="tbx_RecipeSeq15_Current" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                            <Label Grid.Row="14" Grid.Column="2" Content="时序15时间 (0.01s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="14" Grid.Column="3" Name="tbx_RecipeSeq15_Time" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                        </Grid>
                                    </GroupBox>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                        <Button Name="btn_ReadRecipeFromDevice" Content="从设备读取"
                                                Style="{StaticResource StandardButtonStyle}"
                                                Width="130" Height="36" Margin="0,0,20,0"
                                                Click="btn_ReadRecipeFromDevice_Click"/>
                                        <Button Name="btn_ApplyRecipeToDevice" Content="应用到设备"
                                                Style="{StaticResource SuccessButtonStyle}"
                                                Width="130" Height="36"
                                                Click="btn_ApplyRecipeToDevice_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </hc:TabItem>
                <!-- 固件升级 Tab [BL设计 §4.2/§4.3] -->
                <hc:TabItem Header="固件升级">
                    <views:FirmwareUpgradeView x:Name="FirmwareUpgradeView"/>
                </hc:TabItem>
            </hc:TabControl>
        </Grid>

        <GridSplitter Grid.Row="2"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="{DynamicResource BorderBrush}"
                      ShowsPreview="True"
                      Cursor="SizeNS"/>

        <!-- 功率曲线图区域 -->
        <hc:Card Grid.Row="3" Margin="10,0,10,10" BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 图表标题和图例 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="功率曲线"
                               Style="{StaticResource TextBlockLargeBold}"
                               VerticalAlignment="Center"/>

                    <!-- 自定义图例 -->
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <!-- 输入功率图例 -->
                        <Border Background="#1E90FF" Width="30" Height="3" VerticalAlignment="Center" CornerRadius="1"/>
                        <TextBlock Text="输入功率"
                                   Style="{StaticResource TextBlockDefault}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="5,0,15,0"
                                   VerticalAlignment="Center"/>

                        <!-- 输出功率图例 -->
                        <Border Background="#FF4500" Width="30" Height="3" VerticalAlignment="Center" CornerRadius="1"/>
                        <TextBlock Text="输出功率"
                                   Style="{StaticResource TextBlockDefault}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- 图表控件 -->
                <lvc:CartesianChart Grid.Row="1"
                                    Name="PowerChart"
                                    Series="{Binding PowerSeries}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    LegendPosition="Hidden"
                                    ZoomMode="X"
                                    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"/>
            </Grid>
        </hc:Card>

        <!-- 底部状态栏 -->
        <Border Grid.Row="4" Background="{DynamicResource DarkBrush}" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource TextBlockDefault}"
                           FontSize="11"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <!-- 授权码入口暂时停用，取消下方注释可恢复入口。
                <TextBlock Name="tbk_License"
                           Text="📋 许可证管理"
                           Style="{StaticResource TextBlockDefault}"
                           FontSize="11"
                           Foreground="#FFD700"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           MouseDown="TbkLicense_MouseDown"/>
                -->
                <TextBlock Grid.Column="2"
                           Name="tbk_Copyright"
                           Text="版权归瑞达新能源（广州）有限公司所有"
                           Style="{StaticResource TextBlockDefault}"
                           FontSize="11"
                           Foreground="#FFD700"
                           FontWeight="SemiBold"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Name="tbk_Time"
                           Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                           Style="{StaticResource TextBlockDefault}"
                           FontSize="11"
                           Foreground="White"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
            </Grid>
        </Border>
    </Grid>
</hc:Window>
