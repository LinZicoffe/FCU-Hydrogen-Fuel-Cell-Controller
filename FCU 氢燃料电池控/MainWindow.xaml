                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="拉载次数" Style="{StaticResource PressureHeaderStyle}"/>

                                        <TextBox Grid.Row="1" Grid.Column="0" Name="tbx_LoadLockFactor" Style="{StaticResource StandardTextBoxStyle}" Text="0.900" Margin="4"
                                                 ToolTip="锁定系数(0x0502 lock_coefficient，0.001单位，范围0.001~1.000，默认0.900)。锁定电流 = 最大功率时序的设定电流 × 本系数，向下取整到0.1A；需固件 feat/restore-load-lock-coefficient 及之后版本"/>
                                        <Grid Grid.Row="1" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_LoadNormalInterval" Style="{StaticResource StandardTextBoxStyle}" Text="60" Margin="4"/>
                                            <TextBlock Grid.Column="1" Text="min" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_LoadFirstCount" Style="{StaticResource StandardTextBoxStyle}" Text="3" Margin="4"/>
                                            <TextBlock Grid.Column="1" Text="次" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>
                                    </Grid>

                                    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="写入运行参数" Style="{StaticResource SuccessButtonStyle}"
                                                Width="160" Margin="4" Click="btn_SetLoadControlParams_Click"/>
                                        <Button Content="写入周期参数" Style="{StaticResource SuccessButtonStyle}"
                                                Width="160" Margin="4" Click="btn_SetLoadStartParams_Click"/>
                                    </WrapPanel>

                                    <Expander Header="协议高级参数" Margin="4,6,4,0">
                                        <Grid Margin="8,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Label Grid.Row="0" Grid.Column="0" Content="峰值电流 (A)" Style="{StaticResource LabelStyle}" Margin="4"/>
