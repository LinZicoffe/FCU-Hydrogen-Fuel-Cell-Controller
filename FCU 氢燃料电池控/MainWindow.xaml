                                            <Label Grid.Row="0" Grid.Column="2" Content="最低电压 (V)" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="0" Grid.Column="3" Name="tbx_LoadMinVoltage" Style="{StaticResource StandardTextBoxStyle}" Text="8.0" Margin="4"/>
                                            <Label Grid.Row="0" Grid.Column="4" Content="电流步长 (A)" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="0" Grid.Column="5" Name="tbx_LoadCurrentStep" Style="{StaticResource StandardTextBoxStyle}" Text="0.5" Margin="4"/>

                                            <Label Grid.Row="1" Grid.Column="0" Content="首次拉载间隔 (min)" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Name="tbx_LoadFirstInterval" Style="{StaticResource StandardTextBoxStyle}" Text="15" Margin="4"/>
                                            <Label Grid.Row="1" Grid.Column="2" Content="锁定标志" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <CheckBox Grid.Row="1" Grid.Column="3" Name="chk_LoadLockFlag" Content="启用锁定" VerticalAlignment="Center" Margin="4"/>
                                        </Grid>
                                    </Expander>
                                </StackPanel>
