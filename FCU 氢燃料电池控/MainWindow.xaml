<hc:Window x:Class="FCU_氢燃料电池控.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FCU_氢燃料电池控"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="FCU 氢燃料电池控制系统" Height="780" Width="1280"
        MinWidth="1000" MinHeight="600"
        Background="{DynamicResource RegionBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- HandyControl 内置样式引用 -->
        <!-- 按钮样式: ButtonPrimary, ButtonSuccess, ButtonWarning, ButtonDanger, ButtonInfo -->
        <!-- 输入框样式: TextBoxExtend, TextBoxPlus, NumericUpDownExtend -->
        <!-- GroupBox样式: GroupBoxOriginal, GroupBoxTab -->
        <!-- 颜色资源: PrimaryBrush, SuccessBrush, WarningBrush, DangerBrush, InfoBrush -->

        <!-- 基础数值定义 -->
        <sys:Double x:Key="DefaultMargin" xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Double>
        <sys:Double x:Key="DefaultPadding" xmlns:sys="clr-namespace:System;assembly=mscorlib">6</sys:Double>
        <CornerRadius x:Key="DefaultCornerRadius">3</CornerRadius>

        <!-- 自定义颜色（用于兼容旧样式） -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentColor" Color="#2196F3"/>
        <SolidColorBrush x:Key="DarkColor" Color="#0D47A1"/>

        <!-- 按钮样式别名（映射到HandyControl内置样式） -->
        <Style x:Key="StandardButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}"/>
        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonSuccess}"/>
        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDanger}"/>
        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonWarning}"/>

        <!-- 现代 TabItem 样式 (紧凑化: 6个Tab在窄窗口下也能全部显示, 防HandyControl溢出裁剪) -->
        <Style x:Key="ModernTabItem" TargetType="hc:TabItem">
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="hc:TabItem">
                        <Grid>
                            <Border Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,0,0,2"
                                    Margin="1,0,1,0">
                                <ContentPresenter x:Name="ContentSite"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                ContentSource="Header"
                                                Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContentPanel样式 -->
        <Style x:Key="ContentPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Direction="315" ShadowDepth="1" BlurRadius="6" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DropShadowEffect资源（供GroupBox使用） -->
        <DropShadowEffect x:Key="DropShadowEffect" Direction="315" ShadowDepth="1" BlurRadius="6" Opacity="0.08"/>

        <!-- TextBox样式（使用HandyControl主题资源） -->
        <Style x:Key="StandardTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxExtend}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- GroupBox样式（使用HandyControl主题资源） -->
        <Style x:Key="ModernGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource EffectShadow2}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label样式（使用HandyControl主题资源） -->
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- TextBlock样式（使用HandyControl主题资源） -->
        <Style x:Key="TextBlockDisplayStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- 压力参数表的列头（备注） -->
        <Style x:Key="PressureHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,4,6"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- 压力参数表的行头（传感器名） -->
        <Style x:Key="PressureRowHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,4,12,4"/>
        </Style>

        <!-- 实时值显示框：外观对齐输入框，但只读且用主题色区分 -->
        <Style x:Key="PressureLiveBoxStyle" TargetType="Border">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2196F3"/>
            <Setter Property="Background" Value="#F3F8FE"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="PressureLiveTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 标题TextBlock样式 -->
        <Style x:Key="TextBlockHeader" TargetType="TextBlock" BasedOn="{StaticResource TextBlockDefault}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="16,0">
            <TextBlock Name="tbk_ApplicationName"
                       Text="FCU 氢燃料电池控制系统"
                       Style="{StaticResource TextBlockLargeBold}"
                       Foreground="White"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧面板 -->
            <ScrollViewer Grid.Column="0"
                          Margin="0,0,10,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <hc:UniformSpacingPanel Spacing="10" Orientation="Vertical">
                <!-- 串口设置 -->
                <hc:Card BorderThickness="0" Effect="{StaticResource EffectShadow2}">
                    <StackPanel>
                        <TextBlock Text="串口设置"
                                   Style="{StaticResource TextBlockHeader}"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="串口号:" Style="{StaticResource LabelStyle}"/>
                            <hc:ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailablePorts}"
                                      SelectedItem="{Binding SelectedPortName}"
                                      IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                                      Height="32"
                                      hc:InfoElement.Placeholder="请选择串口"
                                      hc:InfoElement.ShowClearButton="True"
                                      FontFamily="Microsoft YaHei UI, Segoe UI, Tahoma, sans-serif"
                                      FontSize="10"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="波特率:" Style="{StaticResource LabelStyle}"/>
                            <hc:ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableBaudRates}"
                                      SelectedItem="{Binding SelectedBaudRate}"
                                      IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                                      Height="32"
                                      hc:InfoElement.Placeholder="请选择波特率"
                                      hc:InfoElement.ShowClearButton="True"
                                      FontFamily="Microsoft YaHei UI, Segoe UI, Tahoma, sans-serif"
                                      FontSize="10"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="从站地址(1-247):" Style="{StaticResource LabelStyle}" FontSize="10"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding DeviceAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32"
                                     FontFamily="Microsoft YaHei UI, Segoe UI, Tahoma, sans-serif"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Padding="5,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0"
                                    Content="刷新串口"
                                    Command="{Binding RefreshPortsCommand}"
                                    Style="{StaticResource StandardButtonStyle}"
                                    Height="36"/>
                            
                            <!-- 打开串口按钮 -->
                            <Button Grid.Column="2"
                                    Content="打开串口"
                                    Command="{Binding OpenSerialCommand}"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Height="36"
                                    Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    
                            <!-- 关闭串口按钮 -->
                            <Button Grid.Column="2"
                                    Content="关闭串口"
                                    Command="{Binding CloseSerialCommand}"
                                    Style="{StaticResource StopButtonStyle}"
                                    Height="36"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>
                </hc:Card>

                <!-- 读取操作 -->
                <hc:Card BorderThickness="0" Effect="{StaticResource EffectShadow2}">
                    <StackPanel>
                        <TextBlock Text="读取操作"
                                   Style="{StaticResource TextBlockHeader}"
                                   Margin="0,0,0,10"/>

                        <Button Content="读取设备序列号"
                                Command="{Binding ReadSerialNumberCommand}"
                                Style="{StaticResource StandardButtonStyle}"
                                Margin="0,0,0,6"/>

                        <Button Content="读取电堆信息"
                                Command="{Binding ReadStackInfoCommand}"
                                Style="{StaticResource StandardButtonStyle}"
                                Margin="0,0,0,6"/>

                        <Button Content="读取配置参数"
                                Command="{Binding ReadConfigCommand}"
                                Style="{StaticResource StandardButtonStyle}"/>
                    </StackPanel>
                </hc:Card>

                <!-- 系统控制 -->
                <hc:Card BorderThickness="0" Effect="{StaticResource EffectShadow2}">
                    <StackPanel>
                        <TextBlock Text="系统控制"
                                   Style="{StaticResource TextBlockHeader}"
                                   Margin="0,0,0,10"/>

                        <Button Content="启动电堆"
                                Command="{Binding StartStackCommand}"
                                Style="{StaticResource SuccessButtonStyle}"
                                Margin="0,0,0,6"/>

                        <Button Content="关闭电堆"
                                Command="{Binding StopStackCommand}"
                                Style="{StaticResource StopButtonStyle}"/>
                    </StackPanel>
                </hc:Card>

                <!-- 设备序列号显示 -->
                <hc:Card BorderThickness="0" Effect="{StaticResource EffectShadow2}">
                    <StackPanel>
                        <TextBlock Text="设备序列号"
                                   Style="{StaticResource TextBlockHeader}"
                                   Margin="0,0,0,10"/>
                        <TextBox Text="{Binding SerialNumber, Mode=OneWay}"
                                 Style="{StaticResource StandardTextBoxStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </hc:Card>
                </hc:UniformSpacingPanel>
            </ScrollViewer>

            <!-- 右侧Tab区域 -->
            <hc:TabControl Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0">
                <!-- FCU参数配置 Tab（合并：压力/阀门/DCDC/风扇温度） -->
                <hc:TabItem Header="FCU参数配置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <TextBlock Text="参数设定：读取当前参数，修改后写入FCU并固化到Flash。" FontWeight="SemiBold" Margin="4,0,4,10"/>
                            <!-- 压力参数 -->
                            <GroupBox Header="压力传感器设置 (KPA)" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,15">
                            <StackPanel>
                                <!-- 读取按钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <Button Name="btn_ReadPressureParams"
                                        Content="读取压力参数"
                                        Style="{StaticResource StandardButtonStyle}"
                                        Width="150"
                                        Margin="4"
                                        Click="btn_ReadPressureParams_Click"/>
                                <Button Content="写入FCU并固化" Command="{Binding SetHighPressureMinCommand}" Style="{StaticResource SuccessButtonStyle}" Width="150" Margin="4"/>
                                </StackPanel>

                                <!-- 表格式布局：保留核心设定项，最后一列为实时值(只读) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- 行头 | 下限值 | 上限值 | 量程 | 实时值 -->
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- ===== 列头（备注） ===== -->
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PressureHeaderStyle}"
                                               Text="下限值"
                                               ToolTip="高压侧为启动门槛；低压侧为低限告警值"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource PressureHeaderStyle}"
                                               Text="上限值"
                                               ToolTip="压力允许区间上限。高压超过设定值触发 CRITICAL 停机；低压超过设定值同样触发 CRITICAL 停机"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource PressureHeaderStyle}"
                                               Text="传感器量程"
                                               ToolTip="传感器满量程。写 0 会被固件静默接受并固化，导致压力读数恒为 0 且重启不恢复"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource PressureHeaderStyle}"
                                               Text="实时压力"
                                               Foreground="#2196F3"
                                               ToolTip="电堆信息(0x07)上报的实测压力，只读"/>

                                    <!-- ===== 第1行：高压传感器 ===== -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PressureRowHeaderStyle}"
                                               Text="高压传感器"/>

                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4"
                                             Text="{Binding HighPressureMin, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StandardTextBoxStyle}"
                                             ToolTip="高压最小值，固件默认 300 KPA"/>

                                    <TextBox Grid.Row="1" Grid.Column="2" Margin="4"
                                             Text="{Binding HighPressureMax, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StandardTextBoxStyle}"
                                             ToolTip="高压上限告警值，高于此值触发 CRITICAL 停机。建议初值 5000 KPA（等于量程），联调后按实际安全值下调"/>

                                    <TextBox Grid.Row="1" Grid.Column="3" Margin="4"
                                             Text="{Binding HighPressureRange, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StandardTextBoxStyle}"
                                             ToolTip="高压量程，固件默认 5000 KPA"/>

                                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource PressureLiveBoxStyle}">
                                        <TextBlock Text="{Binding HighPressure}" Style="{StaticResource PressureLiveTextStyle}"/>
                                    </Border>

                                    <!-- ===== 第2行：低压传感器 ===== -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PressureRowHeaderStyle}"
                                               Text="低压传感器"/>

                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="4"
                                             Text="{Binding LowPressureMin, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StandardTextBoxStyle}"
                                             ToolTip="低压下限值，固件默认 30 KPA"/>

                                    <TextBox Grid.Row="2" Grid.Column="2" Margin="4"
                                             Text="{Binding LowPressureMax, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StandardTextBoxStyle}"
                                             ToolTip="低压上限值，固件默认 80 KPA，须大于下限值。低压超出 [下限, 上限] 区间时禁止启动电堆"/>

                                    <TextBox Grid.Row="2" Grid.Column="3" Margin="4"
                                             Text="{Binding LowPressureRange, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StandardTextBoxStyle}"
                                             ToolTip="低压量程，固件默认 250 KPA"/>

                                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource PressureLiveBoxStyle}">
                                        <TextBlock Text="{Binding LowPressure}" Style="{StaticResource PressureLiveTextStyle}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                            <!-- 阀门参数 -->
                            <GroupBox Header="排水阀门参数设置" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,15">
                            <StackPanel>
                                <!-- 读取按钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <Button Name="btn_ReadValveParams"
                                        Content="读取阀门参数"
                                        Style="{StaticResource StandardButtonStyle}"
                                        Width="150"
                                        Margin="4"
                                        Click="btn_ReadValveParams_Click"/>
                                <Button Content="写入FCU并固化" Style="{StaticResource SuccessButtonStyle}" Width="150" Margin="4" Click="btn_SetValveParams_Click"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="开机第一次时长 (0.1s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Name="tbx_ValveFirstOpen" Style="{StaticResource StandardTextBoxStyle}" Text="5" Margin="4"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="开机第二次时长 (0.1s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Name="tbx_ValveSecondOpen" Style="{StaticResource StandardTextBoxStyle}" Text="20" Margin="4"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="正常周期间隔 (0.1s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Name="tbx_ValveNormalInterval" Style="{StaticResource StandardTextBoxStyle}" Text="150" Margin="4"/>

                                    <Label Grid.Row="3" Grid.Column="0" Content="正常打开时长 (0.1s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Name="tbx_ValveNormalOpen" Style="{StaticResource StandardTextBoxStyle}" Text="3" Margin="4"/>

                                    <Label Grid.Row="4" Grid.Column="0" Content="关机打开时长 (0.1s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Name="tbx_ValveShutdownOpen" Style="{StaticResource StandardTextBoxStyle}" Text="5" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                            <Border CornerRadius="4" Padding="10,6" Background="#F5F5F5"
                                    BorderBrush="#BDBDBD" BorderThickness="1" Margin="0,0,0,15">
                                <TextBlock TextWrapping="Wrap" Foreground="#616161"
                                           Text="氢阀、排水阀的手动开关已确认由上位机控制；当前固件尚无对应RS485指令，本版仅显示实时阀状态，不提供无效的假控制按钮。"/>
                            </Border>

                            <!-- DCDC参数 -->
                            <GroupBox Header="DCDC参数设置" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,15">
                            <StackPanel>
                                <!-- 读取按钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <Button Name="btn_ReadDCDCParams"
                                        Content="读取DCDC参数"
                                        Style="{StaticResource StandardButtonStyle}"
                                        Width="150"
                                        Margin="4"
                                        Click="btn_ReadDCDCParams_Click"/>
                                <Button Content="写入FCU并固化" Style="{StaticResource SuccessButtonStyle}" Width="150" Margin="4" Click="btn_SetDCDCParams_Click"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="放电电压 (0.1V):" Style="{StaticResource LabelStyle}" Margin="4"/>
