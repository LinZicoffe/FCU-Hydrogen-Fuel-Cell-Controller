                                              Width="100" 
                                              Margin="0,0,10,0"
                                              SelectedIndex="0">
                                            <ComboBoxItem Content="0.5秒" Tag="500"/>
                                            <ComboBoxItem Content="1秒" Tag="1000"/>
                                            <ComboBoxItem Content="2秒" Tag="2000"/>
                                            <ComboBoxItem Content="5秒" Tag="5000"/>
                                        </hc:ComboBox>
                                        <Button Name="btn_StartPolling"
                                            Content="开启自动刷新"
                                            Style="{StaticResource StandardButtonStyle}"
                                            Width="120"
                                            Margin="0,0,10,0"
                                            Click="btn_StartPolling_Click"/>
                                        <Button Name="btn_StopPolling"
                                            Content="停止自动刷新"
                                            Style="{StaticResource StandardButtonStyle}"
                                            Width="120"
                                            IsEnabled="False"
