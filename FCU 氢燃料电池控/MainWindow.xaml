                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="序号" Style="{StaticResource PressureHeaderStyle}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="电流 (A)" Style="{StaticResource PressureHeaderStyle}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="持续时间 (s)" Style="{StaticResource PressureHeaderStyle}"/>

