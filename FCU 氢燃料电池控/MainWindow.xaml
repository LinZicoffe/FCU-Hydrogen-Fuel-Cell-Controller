                                    <TextBlock Grid.Row="2" Grid.Column="1" Name="tbk_LoadCurrentVoltage" Text="--" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4"/>

                                    <Label Grid.Row="2" Grid.Column="2" Content="当前功率(W):" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Name="tbk_LoadCurrentPower" Text="--" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4"/>

                                    <!-- 第4行 -->
