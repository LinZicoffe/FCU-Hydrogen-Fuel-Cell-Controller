                        </StackPanel>
                    </ScrollViewer>
                </hc:TabItem>

                <!-- 系统监控 Tab（合并：电堆信息+通用参数） -->
                <hc:TabItem Header="系统监控">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <!-- 电堆实时信息 -->
                            <GroupBox Header="电堆实时信息" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,15">
                                <StackPanel>
                                    <!-- 轮询控制按钮区 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                        <TextBlock Text="轮询间隔:" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,8,0"
                                               FontSize="12"/>
