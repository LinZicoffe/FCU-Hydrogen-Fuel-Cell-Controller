<hc:Window x:Class="FCU_氢燃料电池控.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FCU_氢燃料电池控"
        xmlns:controls="clr-namespace:FCU_氢燃料电池控.Controls"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:views="clr-namespace:FCU_氢燃料电池控.Views"
        mc:Ignorable="d"
        Title="氢燃料电池标定系统" ShowTitle="False" Height="780" Width="1280"
        MinWidth="1000" MinHeight="600"
        Background="{DynamicResource RegionBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- HandyControl 内置样式引用 -->
        <!-- 按钮样式: ButtonPrimary, ButtonSuccess, ButtonWarning, ButtonDanger, ButtonInfo -->
        <!-- 输入框样式: TextBoxExtend, TextBoxPlus, NumericUpDownExtend -->
        <!-- GroupBox样式: GroupBoxOriginal, GroupBoxTab -->
        <!-- 颜色资源: PrimaryBrush, SuccessBrush, WarningBrush, DangerBrush, InfoBrush -->

        <!-- 基础数值定义 -->
        <sys:Double x:Key="DefaultMargin" xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Double>
        <sys:Double x:Key="DefaultPadding" xmlns:sys="clr-namespace:System;assembly=mscorlib">6</sys:Double>
        <CornerRadius x:Key="DefaultCornerRadius">3</CornerRadius>

        <!-- 自定义颜色（用于兼容旧样式） -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentColor" Color="#2196F3"/>
        <SolidColorBrush x:Key="DarkColor" Color="#0D47A1"/>

        <!-- 按钮样式别名（映射到HandyControl内置样式） -->
        <Style x:Key="StandardButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}"/>
        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonSuccess}"/>
        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDanger}"/>
        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonWarning}"/>

        <!-- 现代 TabItem 样式 (紧凑化: 6个Tab在窄窗口下也能全部显示, 防HandyControl溢出裁剪) -->
        <Style x:Key="ModernTabItem" TargetType="hc:TabItem">
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="hc:TabItem">
                        <Grid>
                            <Border Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,0,0,2"
                                    Margin="1,0,1,0">
                                <ContentPresenter x:Name="ContentSite"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                ContentSource="Header"
                                                Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContentPanel样式 -->
        <Style x:Key="ContentPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Direction="315" ShadowDepth="1" BlurRadius="6" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DropShadowEffect资源（供GroupBox使用） -->
        <DropShadowEffect x:Key="DropShadowEffect" Direction="315" ShadowDepth="1" BlurRadius="6" Opacity="0.08"/>

        <!-- TextBox样式（使用HandyControl主题资源） -->
        <Style x:Key="StandardTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxExtend}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TimingTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource StandardTextBoxStyle}">
            <Setter Property="Width" Value="82"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- GroupBox样式（使用HandyControl主题资源） -->
        <Style x:Key="ModernGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource EffectShadow2}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label样式（使用HandyControl主题资源） -->
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- TextBlock样式（使用HandyControl主题资源） -->
        <Style x:Key="TextBlockDisplayStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- 压力参数表的列头（备注） -->
        <Style x:Key="PressureHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,4,6"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- 压力参数表的行头（传感器名） -->
        <Style x:Key="PressureRowHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,4,12,4"/>
        </Style>

        <!-- 实时值显示框：外观对齐输入框，但只读且用主题色区分 -->
        <Style x:Key="PressureLiveBoxStyle" TargetType="Border">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2196F3"/>
            <Setter Property="Background" Value="#F3F8FE"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="PressureLiveTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PressureUnitStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,4,0"/>
        </Style>

        <!-- 标题TextBlock样式 -->
        <Style x:Key="TextBlockHeader" TargetType="TextBlock" BasedOn="{StaticResource TextBlockDefault}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="102"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 顶部品牌与系统标题：第一行展示公司和版本，蓝色第二行只展示系统名称。 -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Name="tbk_ApplicationName"
                               Text="瑞达新能源（广州）有限公司"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#333333"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Name="tbk_ProductVersion"
                               Text="RIDI FCU/DCDC-2026/V1.5"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#9E9E9E"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource PrimaryBrush}" Padding="18,0">
                <TextBlock Name="tbk_SystemName"
                           Text=" "
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧面板 -->
            <ScrollViewer Name="pnl_SerialActions" Grid.Column="0"
                          Margin="0,0,10,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <hc:UniformSpacingPanel Spacing="10" Orientation="Vertical">
                    <!-- 串口设置 -->
                    <hc:Card BorderThickness="0" Effect="{StaticResource EffectShadow2}">
                        <StackPanel>
                            <TextBlock Text="串口设置"
                                   Style="{StaticResource TextBlockHeader}"
                                   Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="串口号:" Style="{StaticResource LabelStyle}"/>
                                <hc:ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailablePorts}"
                                      SelectedItem="{Binding SelectedPortName}"
                                      IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                                      Height="32"
                                      hc:InfoElement.Placeholder="请选择串口"
                                      hc:InfoElement.ShowClearButton="True"
                                      FontFamily="Microsoft YaHei UI, Segoe UI, Tahoma, sans-serif"
                                      FontSize="10"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="波特率:" Style="{StaticResource LabelStyle}"/>
                                <hc:ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableBaudRates}"
                                      SelectedItem="{Binding SelectedBaudRate}"
                                      IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                                      Height="32"
                                      hc:InfoElement.Placeholder="请选择波特率"
                                      hc:InfoElement.ShowClearButton="True"
                                      FontFamily="Microsoft YaHei UI, Segoe UI, Tahoma, sans-serif"
                                      FontSize="10"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="从站地址(1-247):" Style="{StaticResource LabelStyle}" FontSize="10"/>
                                <TextBox Grid.Column="1"
                                     Text="{Binding DeviceAddress, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                                     Height="32"
                                     FontFamily="Microsoft YaHei UI, Segoe UI, Tahoma, sans-serif"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Padding="5,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                    Content="刷新串口"
                                    Command="{Binding RefreshPortsCommand}"
                                    Style="{StaticResource StandardButtonStyle}"
                                    Height="36"/>

                                <!-- 打开串口按钮 -->
                                <Button Grid.Column="2"
                                    Content="打开串口"
                                    Command="{Binding OpenSerialCommand}"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Height="36"
                                    Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                <!-- 关闭串口按钮 -->
                                <Button Grid.Column="2"
                                    Content="关闭串口"
                                    Command="{Binding CloseSerialCommand}"
                                    Style="{StaticResource StopButtonStyle}"
                                    Height="36"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </StackPanel>
                    </hc:Card>

                    <!-- 读取操作 -->
                    <hc:Card BorderThickness="0" Effect="{StaticResource EffectShadow2}">
                        <StackPanel>
                            <TextBlock Text="读取操作"
                                   Style="{StaticResource TextBlockHeader}"
                                   Margin="0,0,0,10"/>

                            <Button Content="读取设备序列号"
                                Command="{Binding ReadSerialNumberCommand}"
                                Style="{StaticResource StandardButtonStyle}"
                                Margin="0,0,0,6"/>

                            <Button Content="读取电堆信息"
                                Command="{Binding ReadStackInfoCommand}"
                                Style="{StaticResource StandardButtonStyle}"
                                Margin="0,0,0,6"/>

                            <Button Content="读取配置参数"
                                Command="{Binding ReadConfigCommand}"
                                Style="{StaticResource StandardButtonStyle}"/>
                        </StackPanel>
                    </hc:Card>

                    <!-- 系统控制 -->
                    <hc:Card BorderThickness="0" Effect="{StaticResource EffectShadow2}">
                        <StackPanel>
                            <TextBlock Text="系统控制"
                                   Style="{StaticResource TextBlockHeader}"
                                   Margin="0,0,0,10"/>

                            <Button Content="启动电堆"
                                Command="{Binding StartStackCommand}"
                                Style="{StaticResource SuccessButtonStyle}"
                                Margin="0,0,0,6"/>

                            <Button Content="关闭电堆"
                                Command="{Binding StopStackCommand}"
                                Style="{StaticResource StopButtonStyle}"/>
                        </StackPanel>
                    </hc:Card>

                    <!-- 设备序列号显示 -->
                    <hc:Card BorderThickness="0" Effect="{StaticResource EffectShadow2}">
                        <StackPanel>
                            <TextBlock Text="设备序列号"
                                   Style="{StaticResource TextBlockHeader}"
                                   Margin="0,0,0,10"/>
                            <TextBox Text="{Binding SerialNumber, Mode=OneWay}"
                                 Style="{StaticResource StandardTextBoxStyle}"
                                 IsReadOnly="True"/>
                        </StackPanel>
                    </hc:Card>
                </hc:UniformSpacingPanel>
            </ScrollViewer>

            <!-- 右侧Tab区域 -->
            <hc:TabControl x:Name="MainTabControl" Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0">
                <!-- FCU参数配置 Tab（合并：压力/阀门/DCDC/风扇温度） -->
                <hc:TabItem Header="FCU参数配置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <TextBlock Text="参数设定：读取当前参数，修改后写入FCU并固化到Flash。" FontWeight="SemiBold" Margin="4,0,4,10"/>
                            <!-- 压力参数 -->
                            <GroupBox Header="压力传感器设置" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,15">
                                <StackPanel>
                                    <!-- 读取按钮 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                        <Button Name="btn_ReadPressureParams"
                                        Content="读取压力参数"
                                        Style="{StaticResource StandardButtonStyle}"
                                        Width="150"
                                        Margin="4"
                                        IsEnabled="{Binding IsConnected}"
                                        Click="btn_ReadPressureParams_Click"/>
                                        <!-- 固件0x02已按18B新格式实现；红/黄阈值不在界面展示，整帧写入时取回读值/固件默认值原样回写。 -->
                                        <Button Content="写入FCU并固化"
                                        Style="{StaticResource SuccessButtonStyle}" Width="200" Margin="4"
                                        IsEnabled="{Binding IsConnected}"
                                        ToolTip="整帧写入18字节压力参数(0x02)并固化Flash。红/黄阈值不在界面展示：先「读取压力参数」再写入可保留设备当前值"
                                        Click="btn_SetPressureParams_Click"/>
                                    </StackPanel>

                                    <!-- 按客户草图排列：最低限制 | 当前值 | 最高限制 | 量程 -->
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <!-- 行头 | 最低限制 | 当前值 | 最高限制 | 量程 -->
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.15*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- ===== 列头（备注） ===== -->
                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PressureHeaderStyle}"
                                               Text="最低限制"
                                               ToolTip="高压侧为启动门槛；低压侧为低限告警值"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource PressureHeaderStyle}"
                                               Text="当前值"
                                               Foreground="#2196F3"
                                               ToolTip="电堆信息(0x07)上报的实测压力，只读"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource PressureHeaderStyle}"
                                               Text="最高限制"
                                               ToolTip="压力允许区间上限。高压超过设定值触发 CRITICAL 停机；低压超过设定值同样触发 CRITICAL 停机"/>
                                        <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource PressureHeaderStyle}"
                                               Text="量程"
                                               ToolTip="传感器满量程。写 0 会被固件静默接受并固化，导致压力读数恒为 0 且重启不恢复"/>

                                        <!-- ===== 第1行：高压传感器 ===== -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PressureRowHeaderStyle}"
                                               Text="高压传感器"/>

                                        <Grid Grid.Row="1" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Margin="4"
                                                 Text="{Binding HighPressureMin, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource StandardTextBoxStyle}"
                                                 ToolTip="高压启动门槛，固件默认 100 KPA（V1.2；高压≥此值才允许启动）"/>
                                            <TextBlock Grid.Column="1" Text="kPa" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>

                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PressureLiveBoxStyle}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding HighPressure}" Style="{StaticResource PressureLiveTextStyle}"/>
                                                <TextBlock Text=" kPa" Style="{StaticResource PressureUnitStyle}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="1" Grid.Column="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Margin="4"
                                                 Text="{Binding HighPressureMax, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource StandardTextBoxStyle}"
                                                 ToolTip="高压上限告警值，达到或超过此值触发过压保护；启动中立即关断，运行中连续3次触发CRITICAL停机。建议初值 5000 KPA（等于量程），联调后按实际安全值下调"/>
                                            <TextBlock Grid.Column="1" Text="kPa" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>

                                        <Grid Grid.Row="1" Grid.Column="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="0 ～" Style="{StaticResource PressureUnitStyle}" Margin="4,0,0,0"/>
                                            <TextBox Grid.Column="1" Margin="4"
                                                 Text="{Binding HighPressureRange, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource StandardTextBoxStyle}"
                                                 ToolTip="高压量程上限，固件默认 5000 KPA，可修改"/>
                                            <TextBlock Grid.Column="2" Text="kPa" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>

                                        <!-- ===== 第2行：低压传感器 ===== -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PressureRowHeaderStyle}"
                                               Text="低压传感器"/>

                                        <Grid Grid.Row="2" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Margin="4"
                                                 Text="{Binding LowPressureMin, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource StandardTextBoxStyle}"
                                                 ToolTip="低压下限值，固件默认 20 KPA；低于此值连续 3 个扫描周期 → CRITICAL 停机"/>
                                            <TextBlock Grid.Column="1" Text="kPa" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>

                                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PressureLiveBoxStyle}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding LowPressure}" Style="{StaticResource PressureLiveTextStyle}"/>
                                                <TextBlock Text=" kPa" Style="{StaticResource PressureUnitStyle}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="2" Grid.Column="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Margin="4"
                                                 Text="{Binding LowPressureMax, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource StandardTextBoxStyle}"
                                                 ToolTip="低压上限值，固件默认 100 KPA；连续 3 个 100ms 采样超限 → CRITICAL 停机。运行中低压 >80KPA 时固件自动开排水阀泄压并上报泄压警示(0x000C)，恢复后自动关阀。须大于下限值，低压超出 [下限, 上限] 区间时禁止启动电堆"/>
                                            <TextBlock Grid.Column="1" Text="kPa" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>

                                        <Grid Grid.Row="2" Grid.Column="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="0 ～" Style="{StaticResource PressureUnitStyle}" Margin="4,0,0,0"/>
                                            <TextBox Grid.Column="1" Margin="4"
                                                 Text="{Binding LowPressureRange, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource StandardTextBoxStyle}"
                                                 ToolTip="低压量程上限，固件默认 250 KPA，可修改"/>
                                            <TextBlock Grid.Column="2" Text="kPa" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- 按客户草图合并温度与双风扇：限制值、当前值、百分比和转速量程同表展示 -->
                            <GroupBox Header="温度与双风扇设置" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                        <Button Name="btn_ReadFanTempParams"
                                                Content="读取风扇温度参数"
                                                Style="{StaticResource StandardButtonStyle}"
                                                Width="190" Margin="4"
                                                IsEnabled="{Binding IsConnected}"
                                                Click="btn_ReadFanTempParams_Click"/>
                                        <Button Content="写入FCU并固化"
                                                Style="{StaticResource SuccessButtonStyle}"
                                                Width="200" Margin="4"
                                                IsEnabled="{Binding IsConnected}"
                                                Click="btn_SetFanTempParams_Click"/>
                                    </StackPanel>

                                    <!-- 温度：最低限制 | 当前温度 | 最高限制 -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="最低限制" Style="{StaticResource PressureHeaderStyle}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="当前温度" Style="{StaticResource PressureHeaderStyle}" Foreground="#2196F3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="最高限制" Style="{StaticResource PressureHeaderStyle}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="电堆温度 (PT1000)" Style="{StaticResource PressureRowHeaderStyle}"/>

                                        <Grid Grid.Row="1" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_TempMin" Style="{StaticResource StandardTextBoxStyle}"
                                                     Text="40.0" Margin="4" ToolTip="温度下限，按0.1℃显示；固件字段为无符号(uint16)不支持负值，且0会被拒收"/>
                                            <TextBlock Grid.Column="1" Text="℃" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>

                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PressureLiveBoxStyle}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StackTemperature}" Style="{StaticResource PressureLiveTextStyle}"/>
                                                <TextBlock Text=" ℃" Style="{StaticResource PressureUnitStyle}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="1" Grid.Column="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_TempMax" Style="{StaticResource StandardTextBoxStyle}"
                                                     Text="60.0" Margin="4" ToolTip="温度上限，按0.1℃显示；固件字段为无符号(uint16)不支持负值，且须大于下限"/>
                                            <TextBlock Grid.Column="1" Text="℃" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>
                                    </Grid>

                                    <Border Height="1" Background="#E0E0E0" Margin="4,0,4,10"/>

                                    <!-- 双风扇：最低占空比 | 当前转速 | 最高占空比 | 转速量程 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="待机占空比" Style="{StaticResource PressureHeaderStyle}"
                                                   ToolTip="待机状态使用的PWM百分比"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="当前转速" Style="{StaticResource PressureHeaderStyle}" Foreground="#2196F3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="拉载占空比" Style="{StaticResource PressureHeaderStyle}"
                                                   ToolTip="进入拉载状态时使用的PWM百分比"/>
                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="转速量程" Style="{StaticResource PressureHeaderStyle}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="风扇1" Style="{StaticResource PressureRowHeaderStyle}"/>
                                        <Grid Grid.Row="1" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_FanLowDuty" Style="{StaticResource StandardTextBoxStyle}" Text="20" Margin="4"
                                                     ToolTip="风扇1待机占空比，随本组「写入FCU并固化」下发(0x06)"/>
                                            <TextBlock Grid.Column="1" Text="%" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PressureLiveBoxStyle}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding FanSpeed}" Style="{StaticResource PressureLiveTextStyle}"/>
                                                <TextBlock Text=" RPM" Style="{StaticResource PressureUnitStyle}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Grid Grid.Row="1" Grid.Column="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_Fan1MaxDuty" Style="{StaticResource StandardTextBoxStyle}" Text="90" Margin="4"
                                                     ToolTip="仅本地预览不下发；拉载占空比在工作流程参数(0x0E)中设置（固件默认30%）"/>
                                            <TextBlock Grid.Column="1" Text="%" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_Fan1MaxRpm" Style="{StaticResource StandardTextBoxStyle}" Text="4000" Margin="4"
                                                     ToolTip="风扇1额定满速，仅作量程显示"/>
                                            <TextBlock Grid.Column="1" Text="RPM" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="风扇2（估算）" Style="{StaticResource PressureRowHeaderStyle}"/>
                                        <Grid Grid.Row="2" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_Fan2MinDuty" Style="{StaticResource StandardTextBoxStyle}" Text="30" Margin="4"
                                                     ToolTip="风扇2待机占空比；当前仅用于本地估算和界面预览"/>
                                            <TextBlock Grid.Column="1" Text="%" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>
                                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PressureLiveBoxStyle}"
                                                ToolTip="风扇2无FG反馈，按温度、最低/最高占空比和转速量程估算">
                                            <TextBlock Text="{Binding Fan2EstimatedSpeed}" Style="{StaticResource PressureLiveTextStyle}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Grid Grid.Row="2" Grid.Column="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_Fan2MaxDuty" Style="{StaticResource StandardTextBoxStyle}" Text="80" Margin="4"
                                                     ToolTip="风扇2拉载占空比；当前仅用于本地估算和界面预览"/>
                                            <TextBlock Grid.Column="1" Text="%" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>
                                        <Grid Grid.Row="2" Grid.Column="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_Fan2MaxRpm" Style="{StaticResource StandardTextBoxStyle}" Text="4000" Margin="4"
                                                     ToolTip="风扇2模拟满速，可修改；估算转速=模拟满速×估算占空比"/>
                                            <TextBlock Grid.Column="1" Text="RPM" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>
                                    </Grid>

                                    <TextBlock Text="风扇1为实测转速；风扇2无FG反馈，显示值为估算转速（百分比）。风扇1待机占空比随本组「写入FCU并固化」下发；拉载占空比在工作流程参数(0x0E)中设置；双路独立控制等待固件协议接入。"
                                               FontSize="11" Foreground="#757575" Margin="4,6,4,0" TextWrapping="Wrap"/>

                                    <!-- 固件0x0F已实现单路手动控制(0x8F确认)；风扇2独立占空比仍待固件双路协议 -->
                                    <Border CornerRadius="4" Padding="10,8" Background="#F5F9FF"
                                            BorderBrush="#90CAF9" BorderThickness="1" Margin="4,10,4,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7"
                                                       Text="风扇手动控制" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,6"/>
                                            <Label Grid.Row="1" Grid.Column="0" Content="风扇1:" Style="{StaticResource LabelStyle}" Margin="0,2,4,2"/>
                                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,2,8,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Name="tbx_FanManualDuty" Style="{StaticResource StandardTextBoxStyle}" Text="60"
                                                         ToolTip="风扇1手动占空比，0～100%"/>
                                                <TextBlock Grid.Column="1" Text="%" Style="{StaticResource PressureUnitStyle}"/>
                                            </Grid>
                                            <Label Grid.Row="1" Grid.Column="2" Content="风扇2:" Style="{StaticResource LabelStyle}" Margin="0,2,4,2"/>
                                            <Grid Grid.Row="1" Grid.Column="3" Margin="0,2,8,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Name="tbx_Fan2ManualDuty" Style="{StaticResource StandardTextBoxStyle}" Text="60" IsEnabled="False"
                                                         ToolTip="固件为单路PWM：手动占空比对风扇1生效，风扇2同占空比跟随；独立双路协议待固件"/>
                                                <TextBlock Grid.Column="1" Text="%" Style="{StaticResource PressureUnitStyle}"/>
                                            </Grid>
                                            <Button Grid.Row="1" Grid.Column="4" Name="btn_EnableFanManual"
                                                    Content="启用手动控制" Style="{StaticResource StandardButtonStyle}"
                                                    Width="125" Margin="4,2"
                                                    IsEnabled="{Binding IsConnected}"
                                                    ToolTip="0x0F设置风扇1手动占空比(1~100%)，任意状态立即生效；仅本次上电有效不写Flash，重启/超温后自动恢复温控"
                                                    Click="btn_EnableFanManual_Click"/>
                                            <Button Grid.Row="1" Grid.Column="5" Name="btn_RestoreFanAutomatic"
                                                    Content="恢复自动温控" Style="{StaticResource SuccessButtonStyle}"
                                                    Width="125" Margin="4,2"
                                                    IsEnabled="{Binding IsConnected}"
                                                    ToolTip="0x0F enable=0，恢复PEM温度闭环"
                                                    Click="btn_RestoreFanAutomatic_Click"/>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7"
                                                        Margin="0,6,0,0" VerticalAlignment="Center">
                                                <TextBlock Name="tbk_FanManualMode" Text="风扇当前模式以FCU侧为准" FontWeight="SemiBold" Foreground="#757575"/>
                                                <TextBlock Text="手动占空比作用于风扇1（单路PWM，风扇2同占空比跟随）；任意状态立即生效，仅本次上电有效不写Flash，重启或超温保护后自动恢复PEM温度闭环。"
                                                           FontSize="11" Foreground="#616161" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Expander Header="保护与时序参数" Margin="4,8,4,0">
                                        <Grid Margin="8,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="全速保持(0.1s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Column="1" Name="tbx_FanFullSpeedTime" Style="{StaticResource StandardTextBoxStyle}" Text="200" Margin="4"/>
                                            <Label Grid.Column="2" Content="低温检测(0.1s):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                            <TextBox Grid.Column="3" Name="tbx_LowTempCheckTime" Style="{StaticResource StandardTextBoxStyle}" Text="1800" Margin="4"/>
                                            <Label Grid.Column="4" Content="堵转阈值(RPM):" Style="{StaticResource LabelStyle}" Margin="4"
                                                   ToolTip="0表示不启用；非0时固件在运行态PWM&gt;30%且连续3个2s采样窗口转速低于阈值，上报0x0004风扇异常告警（警告级、不停机）。须按0x87实测转速标定，勿用数据手册值"/>
                                            <TextBox Grid.Column="5" Name="tbx_FanMinRpm" Style="{StaticResource StandardTextBoxStyle}" Text="0" Margin="4"/>
                                        </Grid>
                                    </Expander>
                                </StackPanel>
                            </GroupBox>

                            <!-- BMS/SOC 参数总览：0x0701回读，0x10写入并固化 -->
                            <GroupBox Header="BMS / SOC 开关机电量" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,15">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="被动自启阈值" Style="{StaticResource PressureHeaderStyle}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="当前 SOC" Style="{StaticResource PressureHeaderStyle}" Foreground="#2196F3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="运行停机上限" Style="{StaticResource PressureHeaderStyle}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="关机充电下限(保留)" Style="{StaticResource PressureHeaderStyle}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="电池容量" Style="{StaticResource PressureHeaderStyle}"/>

                                        <Grid Grid.Row="1" Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_OverviewSocStartMax" Style="{StaticResource StandardTextBoxStyle}" Text="60" Margin="4"
                                                     ToolTip="1～100%；SOC低于该值时被动自动开机，高于该值时拒绝开机（须小于运行停机值）"/>
                                            <TextBlock Grid.Column="1" Text="%" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PressureLiveBoxStyle}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Name="tbk_OverviewBmsSoc" Text="--" Style="{StaticResource PressureLiveTextStyle}"/>
                                                <TextBlock Text=" %" Style="{StaticResource PressureUnitStyle}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Grid Grid.Row="1" Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_OverviewSocStopHigh" Style="{StaticResource StandardTextBoxStyle}" Text="61" Margin="4"
                                                     ToolTip="1～100%；运行中SOC大于该值时自动停机（须大于开机值，形成启动滞回）"/>
                                            <TextBlock Grid.Column="1" Text="%" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_OverviewSocStopMin" Style="{StaticResource StandardTextBoxStyle}" Text="60" Margin="4"
                                                     ToolTip="1～100%；当前固件版本中为保留字段（仅存储回读，不参与控制，依据 fcu_protocol.c fcu_handle_set_soc_params 注释）"/>
                                            <TextBlock Grid.Column="1" Text="%" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Name="tbx_OverviewBatteryCapacity" Style="{StaticResource StandardTextBoxStyle}" Text="8" Margin="4"
                                                     ToolTip="FCU标称容量，正整数Ah；当前仅存储和回读，不参与SOC计算"/>
                                            <TextBlock Grid.Column="1" Text="Ah" Style="{StaticResource PressureUnitStyle}"/>
                                        </Grid>
                                    </Grid>
                                    <Grid Margin="4,8,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Name="tbk_SocValidationStatus"
                                                   Text="FCU默认值：60 / 61 / 60 / 8Ah（关机充电下限为保留字段）；写入固化后需重启FCU生效。"
                                                   Foreground="#616161" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button Grid.Column="1" Content="读取SOC参数" Style="{StaticResource StandardButtonStyle}"
                                                Width="120" Margin="4,0" Click="btn_ReadSocParams_Click"
                                                IsEnabled="{Binding IsConnected}"/>
                                        <Button Grid.Column="2" Content="校验SOC参数" Style="{StaticResource StandardButtonStyle}"
                                                Width="120" Margin="4,0" Click="btn_ValidateSocParams_Click"/>
                                        <Button Grid.Column="3" Content="写入FCU并固化"
                                                Style="{StaticResource SuccessButtonStyle}" Width="150" Margin="4,0" Click="btn_SetSocParams_Click"
                                                IsEnabled="{Binding IsConnected}"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- 阀门时序含 0x0202 扩展时序读写（固件 codex/configurable-valve-timing 分支）；0x0201/0x020E 按原协议 -->
                            <GroupBox Header="氢阀 / 排水阀开关逻辑" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,15">
                                <StackPanel>
                                    <Grid Margin="4,0,4,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="读取FCU参数后回填固件实际值；扩展时序(0x0202)仅电堆关机状态可写入，写入按钮按参数组分别下发。"
                                                   Foreground="#EF6C00" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button Grid.Column="1" Content="校验并刷新预览" Style="{StaticResource StandardButtonStyle}"
                                                Width="130" Margin="4,0" Click="btn_ValidateValveTiming_Click"/>
                                        <Button Grid.Column="2" Content="读取FCU参数" Style="{StaticResource StandardButtonStyle}"
                                                Width="120" Margin="4,0" Click="btn_ReadValvePageParams_Click"
                                                ToolTip="读取阀门排水时序(0x0A+0x0201)、扩展时序(0x0A+0x0202)与工作流程参数(0x0A+0x0601)，回填到本页输入框"/>
                                        <Button Grid.Column="5" Content="写入扩展时序(0x0202)" Style="{StaticResource SuccessButtonStyle}"
                                                Width="150" Margin="4,0" Click="btn_SetValveTimingParams_Click"
                                                ToolTip="写入领启延时、氢阀三段、吹扫停止①②/③、关机排空保持（0x03+0x0202 整帧，仅电堆关机状态接受）；排水领启必须小于氢阀领启"/>
                                        <Button Grid.Column="3" Content="写入排水时序(0x03)" Style="{StaticResource SuccessButtonStyle}"
                                                Width="140" Margin="4,0" Click="btn_SetValveParams_Click"
                                                ToolTip="写入电堆吹扫①/②、排水间隔/打开时长（0x03 整帧）；关机排水时长为固件死参数，按当前保留值原样回传"/>
                                        <Button Grid.Column="4" Content="写入关机流程(0x0E)" Style="{StaticResource SuccessButtonStyle}"
                                                Width="140" Margin="4,0" Click="btn_SetFlowParams_Click"
                                                ToolTip="写入氢阀补气①/关闭②/补气②、关机排水保持、排水模式(定时)、低压阈值、拉载风扇占空比（0x0E 整帧）"/>
                                    </Grid>

                                    <!-- 开机阶段 -->
                                    <Border BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="6" Margin="4" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="开机时序（t=0：12V 上电，两轨并行计时）"
                                                       FontSize="15" FontWeight="SemiBold" Foreground="#1565C0"/>
                                            <TextBlock Text="t=0 为 12V 上电时刻；排水阀/氢阀分别经各自领启延时后启动序列，两轨独立并行推进（氢阀领启必须晚于排水领启）。"
                                                       FontSize="11" Foreground="#616161" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                            <controls:ValveTimingPreview x:Name="startupValveTimingPreview" Height="170" Margin="0,2,0,4"/>
                                            <TextBlock x:Name="tbk_StartupTimingStatus" Foreground="#2E7D32" Margin="4,0,4,6" TextWrapping="Wrap"/>
                                            <!-- 领启延时（0x0202）：两轨自 12V 上电的启动延时 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="领启延时（自12V上电）：" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#455A64"/>
                                                <TextBlock Text="排水" VerticalAlignment="Center" Margin="10,0,4,0"
                                                           ToolTip="0x0202 startup_drain_delay：12V 上电至排水序列启动的延时"/>
                                                <TextBox Name="tbx_StartupDrainLeadDelay" Style="{StaticResource TimingTextBoxStyle}" Text="0.50" TextChanged="ValveTimingInput_TextChanged"
                                                         ToolTip="0x0202 startup_drain_delay（默认 0.5s）：12V 上电至排水阀序列启动的延时，必须小于氢阀领启"/>
                                                <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                <TextBlock Text="氢阀" VerticalAlignment="Center" Margin="12,0,4,0"
                                                           ToolTip="0x0202 startup_h2_delay：12V 上电至氢阀序列启动的延时"/>
                                                <TextBox Name="tbx_StartupH2LeadDelay" Style="{StaticResource TimingTextBoxStyle}" Text="1.50" TextChanged="ValveTimingInput_TextChanged"
                                                         ToolTip="0x0202 startup_h2_delay（默认 1.5s）：12V 上电至氢阀序列启动的延时，固件要求严格大于排水领启"/>
                                                <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                            </StackPanel>
                                            <!-- 客户要求：氢阀参数与排水/吹扫参数分别成行，不再交叉排列。 -->
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" Grid.Column="0" Background="#E3F2FD" CornerRadius="4" Margin="0,2,8,4">
                                                    <TextBlock Text="氢阀" Foreground="#1565C0" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <UniformGrid Grid.Row="0" Grid.Column="1" Columns="3" Margin="0,0,0,4">
                                                    <StackPanel>
                                                        <TextBlock Text="氢阀初始关闭" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                   ToolTip="领启后氢阀先保持关闭的时长"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBox Name="tbx_StartupH2FirstDelay" Style="{StaticResource TimingTextBoxStyle}" Text="0.30" TextChanged="ValveTimingInput_TextChanged"
                                                                     ToolTip="0x0202 h2_start_close1（默认 0.3s）：领启后氢阀初始关闭时长，随「写入扩展时序(0x03+0x0202)」下发"/>
                                                            <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="氢阀打开①" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                   ToolTip="氢阀第一次打开保持时长"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBox Name="tbx_StartupH2FirstOpen" Style="{StaticResource TimingTextBoxStyle}" Text="1.00" TextChanged="ValveTimingInput_TextChanged"
                                                                     ToolTip="0x0202 h2_start_open（默认 1.0s）：氢阀开启时长，随「写入扩展时序(0x03+0x0202)」下发"/>
                                                            <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="氢阀再开前关闭" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                   ToolTip="氢阀第一次打开结束后、再次常开前的关闭时长"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBox Name="tbx_StartupH2ReopenDelay" Style="{StaticResource TimingTextBoxStyle}" Text="0.30" TextChanged="ValveTimingInput_TextChanged"
                                                                     ToolTip="0x0202 h2_start_close2（默认 0.3s）：再开前关闭时长，此后氢阀常开至停机，随「写入扩展时序(0x03+0x0202)」下发"/>
                                                            <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </UniformGrid>

                                                <Border Grid.Row="1" Grid.Column="0" Background="#E8F5E9" CornerRadius="4" Margin="0,2,8,0">
                                                    <TextBlock Text="排水阀" Foreground="#2E7D32" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <UniformGrid Grid.Row="1" Grid.Column="1" Columns="5">
                                                    <StackPanel>
                                                        <TextBlock Text="电堆吹扫①" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBox Name="tbx_StartupDrainFirstOpen" Style="{StaticResource TimingTextBoxStyle}" Text="1.20" TextChanged="ValveTimingInput_TextChanged"/>
                                                            <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="吹扫停止①" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBox Name="tbx_StartupDrainFirstClose" Style="{StaticResource TimingTextBoxStyle}" Text="0.30" TextChanged="ValveTimingInput_TextChanged"
                                                                     ToolTip="0x0202 start_pause1（默认 0.3s）：排水第一次关闭时长，随「写入扩展时序(0x03+0x0202)」下发"/>
                                                            <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="电堆吹扫②" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBox Name="tbx_StartupDrainSecondOpen" Style="{StaticResource TimingTextBoxStyle}" Text="1.00" TextChanged="ValveTimingInput_TextChanged"/>
                                                            <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="吹扫停止②" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBox Name="tbx_StartupDrainThirdInterval" Style="{StaticResource TimingTextBoxStyle}" Text="0.30" TextChanged="ValveTimingInput_TextChanged"
                                                                     ToolTip="0x0202 start_pause2（默认 0.3s）：排水第二次关闭时长，随「写入扩展时序(0x03+0x0202)」下发"/>
                                                            <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="电堆吹扫③" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBox Name="tbx_StartupDrainThirdOpen" Style="{StaticResource TimingTextBoxStyle}" Text="1.00" TextChanged="ValveTimingInput_TextChanged"
                                                                     ToolTip="0x0202 start_third_duration（默认 1.0s）：排水第三次开启时长，结束后进入正常运行排水，随「写入扩展时序(0x03+0x0202)」下发"/>
                                                            <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </Grid>
                                            <TextBlock Text="领启延时、氢阀三段、吹扫停止①②、吹扫③均为 0x0202 扩展时序（固件 codex/configurable-valve-timing 分支，仅电堆关机状态可写入），随「写入扩展时序(0x03+0x0202)」下发；可编辑的吹扫①/②随「写入排水时序(0x03)」写入。固件要求：九项均大于 0 且排水领启 &lt; 氢阀领启。"
                                                       FontSize="11" Foreground="#757575" Margin="4,6,4,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 正常运行阶段 -->
                                    <Border BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="6" Margin="4" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="正常运行排水" FontSize="15" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                            <TextBlock Text="定时触发 → 排水阀打开 → 关闭 → 重新计时（低压反馈模式当前固件未开放）"
                                                       FontSize="11" Foreground="#616161" Margin="0,2,0,6"/>
                                            <WrapPanel ItemWidth="225">
                                                <StackPanel Orientation="Horizontal">
                                                    <Label Content="排水模式" Style="{StaticResource LabelStyle}" Width="105"/>
                                                    <hc:ComboBox Name="cbx_DrainMode" SelectedIndex="0" Width="120" Margin="4,2">
                                                        <ComboBoxItem Content="定时"/>
                                                        <ComboBoxItem Content="低压反馈" IsEnabled="False"
                                                                      ToolTip="当前固件 0x0E 的 drain_mode 仅接受 0=定时（fcu_protocol_set_flow_params 校验非 0 拒收，错误码 0x02 参数无效）"/>
                                                    </hc:ComboBox>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Label Content="排水间隔" Style="{StaticResource LabelStyle}" Width="105"/>
                                                    <TextBox Name="tbx_ValveNormalInterval" Style="{StaticResource TimingTextBoxStyle}" Text="15.00"/>
                                                    <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Label Content="排水打开" Style="{StaticResource LabelStyle}" Width="105"/>
                                                    <TextBox Name="tbx_ValveNormalOpen" Style="{StaticResource TimingTextBoxStyle}" Text="0.30"/>
                                                    <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Label Content="低压反馈阈值" Style="{StaticResource LabelStyle}" Width="105"/>
                                                    <TextBox Name="tbx_LowNormalRef" Style="{StaticResource TimingTextBoxStyle}" Text="55"/>
                                                    <TextBlock Text="kPa" Style="{StaticResource PressureUnitStyle}"/>
                                                </StackPanel>
                                            </WrapPanel>
                                            <TextBlock Text="低压反馈模式当前固件不支持（drain_mode 仅接受定时）；阈值字段随 0x0E 保存（固件要求非 0），不参与定时排水控制。"
                                                       FontSize="11" Foreground="#757575" Margin="4,5,4,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 关机阶段 -->
                                    <Border BorderBrush="#FFCC80" BorderThickness="1" CornerRadius="6" Margin="4" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="关机时序（t=0：收到有效 RS485 关机指令）"
                                                       FontSize="15" FontWeight="SemiBold" Foreground="#EF6C00"/>
                                            <TextBlock Text="t=0 同时打开氢阀（purge 补气）与排水阀；氢阀 补气①→关闭②→补气②→终关，排水阀连续保持至排氢关机时长（排水保持+排空）结束，双路完成后断 12V。"
                                                       FontSize="11" Foreground="#616161" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                            <controls:ValveTimingPreview x:Name="shutdownValveTimingPreview" Height="170" Margin="0,2,0,4"/>
                                            <TextBlock x:Name="tbk_ShutdownTimingStatus" Foreground="#2E7D32" Margin="4,0,4,6" TextWrapping="Wrap"/>
                                            <!-- 关机阶段同样按阀门分组：氢阀三框（补气①/关闭②/补气②，对应固件 开1→关→开2 四段，终关无参数框）在一行，排水阀总时长独立一行。 -->
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Grid.Column="0" Background="#FFF3E0" CornerRadius="4" Margin="0,2,8,4">
                                                    <TextBlock Text="氢阀" Foreground="#EF6C00" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <UniformGrid Grid.Row="0" Grid.Column="1" Columns="3" Margin="0,0,0,4">
                                                    <StackPanel>
                                                        <TextBlock Text="氢阀补气①" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBox Name="tbx_ShutdownH2Open1" Style="{StaticResource TimingTextBoxStyle}" Text="0.50" TextChanged="ValveTimingInput_TextChanged"/>
                                                            <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="氢阀关闭②" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBox Name="tbx_ShutdownH2Close2" Style="{StaticResource TimingTextBoxStyle}" Text="1.00" TextChanged="ValveTimingInput_TextChanged"/>
                                                            <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="氢阀补气②" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBox Name="tbx_ShutdownH2Open2" Style="{StaticResource TimingTextBoxStyle}" Text="0.50" TextChanged="ValveTimingInput_TextChanged"/>
                                                            <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </UniformGrid>
                                                <Border Grid.Row="1" Grid.Column="0" Background="#E8F5E9" CornerRadius="4" Margin="0,2,8,0">
                                                    <TextBlock Text="排水阀" Foreground="#2E7D32" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Width="230" HorizontalAlignment="Left">
                                                    <TextBlock Text="排氢关机时长" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               ToolTip="排水阀从收到关机指令起持续打开的总时长"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBox Name="tbx_ShutdownTotal" Style="{StaticResource TimingTextBoxStyle}" Text="8.00" TextChanged="ValveTimingInput_TextChanged" IsEnabled="False"
                                                                 ToolTip="自动计算：关机排水保持(0x0E) + 关机排空保持(0x0202 shutdown_empty)，随输入实时重算，仅预览"/>
                                                        <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <!-- 0x0E 工作流程参数：固件 fcu_protocol_set_flow_params 实际支持的其余字段
                                                 (氢阀补气①/关闭②/补气② 已映射到上方时序输入框) -->
                                            <WrapPanel Margin="0,8,0,0" ItemWidth="225">
                                                <StackPanel Orientation="Horizontal">
                                                    <Label Content="关机排水保持" Style="{StaticResource LabelStyle}" Width="105"
                                                           ToolTip="0x0E purge_drain_hold：关机时排水阀保持打开时长"/>
                                                    <TextBox Name="tbx_PurgeDrainHoldSec" Style="{StaticResource TimingTextBoxStyle}" Text="3.00" TextChanged="ValveTimingInput_TextChanged"/>
                                                    <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Label Content="关机排空保持" Style="{StaticResource LabelStyle}" Width="105"
                                                           ToolTip="0x0202 shutdown_empty：关机排空的额外保持时长，排水连续开启总时长=关机排水保持+本值"/>
                                                    <TextBox Name="tbx_ShutdownEmptySec" Style="{StaticResource TimingTextBoxStyle}" Text="5.00" TextChanged="ValveTimingInput_TextChanged"
                                                             ToolTip="0x0202 shutdown_empty（默认 5.0s）：关机排空的额外保持时长；排水连续开启总时长 = 关机排水保持(0x0E) + 本值，随「写入扩展时序(0x03+0x0202)」下发"/>
                                                    <TextBlock Text="s" Style="{StaticResource PressureUnitStyle}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Label Content="拉载风扇占空比" Style="{StaticResource LabelStyle}" Width="110"
                                                           ToolTip="0x0E load_duty：拉载期间风扇占空比(%)"/>
                                                    <TextBox Name="tbx_LoadDuty" Style="{StaticResource TimingTextBoxStyle}" Text="30"/>
                                                    <TextBlock Text="%" Style="{StaticResource PressureUnitStyle}"/>
                                                </StackPanel>
                                            </WrapPanel>
                                            <TextBlock Text="排氢关机时长 = 关机排水保持(0x0E) + 关机排空保持(0x0202 shutdown_empty)，随输入实时重算、读取FCU参数后回填；关机氢阀序列为 补气①→关闭②→补气②→终关（固件 purge 终关无参数框）。补气①/关闭②/补气②随「写入关机流程(0x0E)」写入，排空保持随「写入扩展时序(0x03+0x0202)」写入。"
                                                       FontSize="11" Foreground="#757575" Margin="4,5,4,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border CornerRadius="4" Padding="10,8" Background="#F5F5F5"
                                            BorderBrush="#BDBDBD" BorderThickness="1" Margin="4,8,4,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="阀门实时状态" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding HydrogenValveState, StringFormat=氢阀：{0}}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding DrainValveState, StringFormat=排水阀：{0}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="上位机手动控制（等待固件 RS485 指令与安全联锁）" Foreground="#EF6C00" Margin="0,0,0,4"/>
                                                <WrapPanel>
                                                    <Button Content="开氢阀" IsEnabled="False" Style="{StaticResource StandardButtonStyle}" Width="90" Margin="0,2,6,2"/>
                                                    <Button Content="关氢阀" IsEnabled="False" Style="{StaticResource StandardButtonStyle}" Width="90" Margin="0,2,6,2"/>
                                                    <Button Content="开排水阀" IsEnabled="False" Style="{StaticResource StandardButtonStyle}" Width="100" Margin="0,2,6,2"/>
                                                    <Button Content="关排水阀" IsEnabled="False" Style="{StaticResource StandardButtonStyle}" Width="100" Margin="0,2,6,2"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- stop_duration(0x03 关机排水时长)：固件死参数（可读写但关机控制逻辑未使用，
                                         实际排水保持由 0x0E purge_drain_hold + 0x0202 shutdown_empty 决定）。
                                         保留隐藏框仅为 0x03 整帧写入时原样回传，避免误改设备存储值。 -->
                                    <Grid Visibility="Collapsed">
                                        <TextBox Name="tbx_ValveShutdownOpen" Text="5"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- DCDC参数 -->
                            <GroupBox Header="DCDC参数设置" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,15">
                                <StackPanel>
                                    <!-- 读取按钮 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                        <Button Name="btn_ReadDCDCParams"
                                        Content="读取DCDC参数"
                                        Style="{StaticResource StandardButtonStyle}"
                                        Width="150"
                                        Margin="4"
                                        Click="btn_ReadDCDCParams_Click"/>
                                        <Button Content="写入FCU并固化" Style="{StaticResource SuccessButtonStyle}" Width="150" Margin="4" Click="btn_SetDCDCParams_Click"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Label Grid.Row="0" Grid.Column="0" Content="DCDC门控电压 (0.1V):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Name="tbx_DCDCMinVoltage" ToolTip="启动堆电压须高于此值才能开启DCDC；关机期间低于此值开放电、达到或高于此值关闭放电，默认8.0V" Style="{StaticResource StandardTextBoxStyle}" Text="80" Margin="4"/>

                                        <Label Grid.Row="1" Grid.Column="0" Content="保留截止值 (0.1V):" Style="{StaticResource LabelStyle}" Margin="4"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Name="tbx_DCDCStopVoltage" ToolTip="保留配置并可回读；当前main关机放电不按此值控制，2V截止采样点仍待确认" Style="{StaticResource StandardTextBoxStyle}" Text="20" Margin="4"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                        </StackPanel>
                    </ScrollViewer>
                </hc:TabItem>

                <!-- 唯一一套电流设置：不再提供轻载/重载/配方切换 -->
                <hc:TabItem Header="电流设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <GroupBox Name="grp_CurrentCalibration" Header="输入拉载标定（0x0302）" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="输入拉载标定（0x0302）" FontSize="16" FontWeight="SemiBold" Foreground="#1976D2" Margin="4,0,4,8"/>
                                    <Border Background="#E3F2FD" CornerRadius="4" Padding="12,8" Margin="4,0,4,10">
                                        <StackPanel>
                                            <WrapPanel>
                                                <TextBlock Text="当前输入电流（A）：" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
