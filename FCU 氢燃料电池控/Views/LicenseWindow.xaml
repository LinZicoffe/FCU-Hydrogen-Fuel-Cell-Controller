<Window x:Class="FCU_氢燃料电池控.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="许可证管理"
        Height="550" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- 颜色定义 -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentColor" Color="#2196F3"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FF9800"/>
        <SolidColorBrush x:Key="DangerColor" Color="#F44336"/>

        <!-- 按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 卡片样式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文本框样式 -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="许可证管理" FontSize="24" FontWeight="Bold" Foreground="#333333"/>
            <TextBlock Text="激活或管理您的软件许可证" FontSize="14" Foreground="#666666" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 主内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 许可证状态卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="当前状态" FontSize="16" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="许可证状态: " FontSize="14" Foreground="#666666"/>
                            <TextBlock x:Name="txtStatus" Text="检查中..." FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock x:Name="txtRemainingDays" FontSize="14" Margin="0,5,0,0"/>
                        <TextBlock x:Name="txtErrorMessage" FontSize="12" Foreground="#F44336" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- 硬件信息卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="硬件信息" FontSize="16" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,10"/>
                        <TextBox x:Name="txtHardwareInfo"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="100"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 VerticalContentAlignment="Top"/>
                        <Button x:Name="btnCopyHardwareInfo"
                                Content="复制硬件信息"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="120"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Click="BtnCopyHardwareInfo_Click"/>
                    </StackPanel>
                </Border>

                <!-- 导入许可证卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="导入许可证文件" FontSize="16" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtLicensePath"
                                     Grid.Column="0"
                                     IsReadOnly="True"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="请选择许可证文件 (.license)"
                                     VerticalContentAlignment="Center"/>

                            <Button x:Name="btnBrowse"
                                    Grid.Column="1"
                                    Content="浏览..."
                                    Width="80"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnBrowseLicense_Click"/>
                        </Grid>
                        <Button x:Name="btnActivate"
                                Content="激活许可证"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="120"
                                HorizontalAlignment="Left"
                                Click="BtnActivate_Click"/>
                    </StackPanel>
                </Border>

                <!-- 许可证详情卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="许可证详情" FontSize="16" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                            <StackPanel x:Name="licenseDetailsPanel">
                                <TextBlock Text="未激活许可证" FontSize="14" Foreground="#999999"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MinHeight="100"/>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮区域 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnClose"
                    Content="关闭"
                    Width="100"
                    Height="35"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
