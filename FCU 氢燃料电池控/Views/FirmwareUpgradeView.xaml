<UserControl x:Class="FCU_氢燃料电池控.Views.FirmwareUpgradeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="900">

    <!-- 固件升级页 (OpenBLT XCP): 选 S-record → 前置检查 → 兼容引导设备断电进入 BL → 连机/擦除/写入/固化 → 重启验证 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="10" MinHeight="540">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 升级包选择 -->
        <Border Grid.Row="0" Background="{DynamicResource RegionBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <!-- [OpenBLT 适配] 本页面向 Boot-For-FCU(OpenBLT) 引导, 依据 docs/实施步骤-OpenBLT升级与固件适配.md -->
                <TextBlock Name="tbk_UpgradeNotice"
                           Text="ℹ 本升级面向 OpenBLT 引导的固件：需先 SWD 预烧 Boot-For-FCU 引导程序（BL 占 0x08000000 起 12K），固件文件为 codex/openblt-app-upgrade 分支构建的 S-record 产物；升级期间 RS485 总线上仅连接这一台 FCU（XCP 无设备地址过滤，多站同答会冲突）。"
                           TextWrapping="Wrap" Foreground="#1565C0" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="选择 S-record 固件 (.srec/.s19/.mot)..." Padding="12,4" Click="BtnSelectFile_Click"/>
                    <TextBlock Name="tbk_FilePath" Text="未选择" VerticalAlignment="Center" Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                </StackPanel>
                <TextBlock Text="本页仅适用于已安装兼容OpenBLT引导的设备和配套S-record镜像。当前main独立APP从0x08000000启动，应通过SWD烧录，不能直接在此升级。" TextWrapping="Wrap" Foreground="#EF6C00" Margin="0,8,0,0"/>
                <TextBlock Name="tbk_PkgInfo" Text="包信息: --" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>

        <!-- 设备信息 -->
        <Border Grid.Row="1" Background="{DynamicResource RegionBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="设备UID: " VerticalAlignment="Center"/>
                <TextBlock Name="tbk_DeviceUid" Text="--" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <TextBlock Text="设备固件版本: " VerticalAlignment="Center"/>
                <TextBlock Name="tbk_DeviceVer" Text="--" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 步骤指示 -->
        <Border Grid.Row="2" Background="{DynamicResource RegionBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Name="tbk_Step1" Text="① 选择固件文件并核对" Margin="0,2"/>
                <TextBlock Name="tbk_Step2" Text="② 前置检查（电堆关机/故障，暂停轮询）" Margin="0,2"/>
                <TextBlock Name="tbk_Step3" Text="③ 连接已安装的OpenBLT引导（按提示断电重启）" Margin="0,2"/>
                <TextBlock Name="tbk_Step4" Text="④ 连机 / 擦除 / 写入 / 固化" Margin="0,2"/>
                <TextBlock Name="tbk_Step5" Text="⑤ 重启验证" Margin="0,2"/>
            </StackPanel>
        </Border>

        <!-- 进度与操作 -->
        <Border Grid.Row="3" Background="{DynamicResource RegionBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Name="pbar_Progress" Height="18" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock Name="tbk_Progress" Grid.Column="1" Text="0%  (0/0 KB)" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Name="btn_Start" Content="开始升级" Padding="16,5" FontWeight="Bold" Click="BtnStart_Click"/>
                    <Button Name="btn_Cancel" Content="取消" Padding="16,5" Margin="12,0,0,0" IsEnabled="False" Click="BtnCancel_Click"/>
                    <TextBlock Name="tbk_Status" Text="空闲" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 分隔 -->
        <Separator Grid.Row="4" Margin="0,2,0,6"/>

        <!-- 日志 -->
        <ListBox Name="lbx_Log" Grid.Row="5" FontFamily="Consolas" FontSize="12"/>
    </Grid>
    </ScrollViewer>
</UserControl>
