<Window x:Class="FCU_氢燃料电池控.Views.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="公司注册"
        Width="500"
        MinHeight="300"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="首次使用注册"
                   FontSize="22"
                   FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,18"
                   Foreground="#666666"
                   Text="请输入公司名称。注册成功后，公司名称将作为程序名称且无法再次修改。"
                   TextWrapping="Wrap"/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="公司名称" Margin="0,0,0,8"/>
            <TextBox x:Name="CompanyNameTextBox"
                     Height="38"
                     MaxLength="100"
                     Padding="8,4"
                     Background="White"
                     Foreground="#222222"
                     BorderBrush="#A0A0A0"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="88" Height="32" Margin="0,0,10,0" Content="退出" Click="CancelButton_Click"/>
            <Button Width="88" Height="32" Content="确认注册" IsDefault="True" Click="RegisterButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
