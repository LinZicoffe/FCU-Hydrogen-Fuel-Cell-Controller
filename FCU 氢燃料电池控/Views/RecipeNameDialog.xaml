<hc:Window x:Class="FCU_氢燃料电池控.Views.RecipeNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="输入配方名称" Height="180" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource RegionBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="tbk_Prompt" Text="请输入配方名称"
                   Style="{DynamicResource TextBlockHeader}"
                   Margin="0,0,0,10"/>

        <TextBox Grid.Row="1" Name="tbx_Input"
                 Style="{DynamicResource TextBoxExtend}"
                 hc:InfoElement.Placeholder="请输入名称"
                 Height="32" FontSize="13"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="确定" Style="{DynamicResource ButtonPrimary}" Width="80" Height="32" Margin="0,0,10,0" Click="Btn_OK_Click"/>
            <Button Content="取消" Style="{DynamicResource ButtonDefault}" Width="80" Height="32" Click="Btn_Cancel_Click"/>
        </StackPanel>
    </Grid>
</hc:Window>
